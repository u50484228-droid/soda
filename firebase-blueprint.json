{
  "entities": {
    "AnalyticsSummary": {
      "description": "Aggregated real-time metrics including visits, clicks, scroll depth, countries and dwell time",
      "fields": {
        "totalVisits": { "type": "number", "description": "Total visits recorded across all users" },
        "uniqueVisitors": { "type": "number", "description": "Count of unique visitor IDs" },
        "totalClicks": { "type": "number", "description": "Total button clicks recorded" },
        "checkoutClicks": { "type": "number", "description": "Total checkout / package purchase button clicks" },
        "totalTimeSeconds": { "type": "number", "description": "Accumulated active duration on site" },
        "countries": { "type": "object", "description": "Map of countries with visitor counts and cities" },
        "buttonClicks": { "type": "object", "description": "Map of button names with click counts" },
        "scrollMilestones": { "type": "object", "description": "Breakdown of visits reaching each scroll depth milestone" },
        "lastUpdated": { "type": "string", "description": "ISO timestamp of last activity update" }
      }
    },
    "AnalyticsEvent": {
      "description": "Chronological stream of real-time actions (visits, button clicks, geolocation, scroll milestones)",
      "fields": {
        "type": { "type": "string", "description": "Type of event: visit, click, scroll, geo" },
        "detail": { "type": "string", "description": "Human-readable description of event" },
        "location": { "type": "string", "description": "Country / city of visitor if applicable" },
        "flag": { "type": "string", "description": "Flag emoji of visitor country" },
        "timestamp": { "type": "string", "description": "ISO timestamp of event occurrence" }
      }
    },
    "AnalyticsSession": {
      "description": "Complete visitor journey profile tracking exact buttons clicked, cookie allow/close, bounce status and scroll depth",
      "fields": {
        "sessionId": { "type": "string", "description": "Unique session ID" },
        "visitorId": { "type": "string", "description": "Persistent visitor identifier" },
        "ip": { "type": "string", "description": "Visitor IP" },
        "city": { "type": "string", "description": "City" },
        "country": { "type": "string", "description": "Country name" },
        "countryCode": { "type": "string", "description": "Country 2-letter code" },
        "flag": { "type": "string", "description": "Country flag emoji" },
        "device": { "type": "string", "description": "Mobile or Desktop" },
        "enteredAt": { "type": "string", "description": "ISO timestamp of visit start" },
        "enteredTimeFormatted": { "type": "string", "description": "Time string e.g. 14:32:10" },
        "lastActiveAt": { "type": "string", "description": "ISO timestamp of last interaction" },
        "durationSeconds": { "type": "number", "description": "Total active time in seconds" },
        "maxScrollPercent": { "type": "number", "description": "Max page scroll depth percentage" },
        "maxScrollSection": { "type": "string", "description": "Deepest section reached" },
        "cookieAction": { "type": "string", "description": "allow, close, or ignored" },
        "buttonsClicked": { "type": "array", "description": "List of button names clicked" },
        "actionsCount": { "type": "number", "description": "Total actions executed in session" },
        "outcome": { "type": "string", "description": "allow, close, checkout, or bounced_no_clicks" },
        "timeline": { "type": "array", "description": "Step-by-step visitor interaction logs" }
      }
    }
  },
  "firestore": {
    "/analytics_summary/global_metrics": {
      "entity": "AnalyticsSummary",
      "description": "Global aggregated analytics document for SodaTide"
    },
    "/analytics_events/{eventId}": {
      "entity": "AnalyticsEvent",
      "description": "Individual event logs stream"
    },
    "/analytics_sessions/{sessionId}": {
      "entity": "AnalyticsSession",
      "description": "Per-visitor session profiles tracking buttons, cookie actions and bounce status"
    }
  }
}
